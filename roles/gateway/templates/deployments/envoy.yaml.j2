---
apiVersion: v1
kind: ConfigMap
metadata:
  name: '{{ ansible_operator_meta.name }}-envoy-config'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
    app.kubernetes.io/managed-by: awx-operator
data:
  envoy.yaml: |
    node:
      id: envoy-{{ ansible_operator_meta.name }}
      cluster: envoy
    dynamic_resources:
      cds_config:
        resource_api_version: V3
        api_config_source:
          api_type: REST
          transport_api_version: V3
          cluster_names: [gateway-control-plane-rest]
          refresh_delay: {seconds: 15}
      lds_config:
        resource_api_version: V3
        api_config_source:
          api_type: REST
          transport_api_version: V3
          cluster_names: [gateway-control-plane-rest]
          refresh_delay: {seconds: 15}
    static_resources:
      clusters:
      - name: gateway-control-plane-rest
        type: STRICT_DNS
        connect_timeout: 5s
        typed_extension_protocol_options:
          envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
            "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
            explicit_http_config:
              http_protocol_options: {}
        load_assignment:
          cluster_name: gateway-control-plane-rest
          endpoints:
          - lb_endpoints:
            - endpoint:
                address:
                  socket_address: {address: {{ ansible_operator_meta.name }}, port_value: 8000}
        transport_socket:
          name: envoy.transport_sockets.tls
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
            common_tls_context:
              validation_context:
                trust_chain_verification: ACCEPT_UNTRUSTED
      - name: gateway_control_plane
        type: STRICT_DNS
        connect_timeout: 5s
        typed_extension_protocol_options:
          envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
            "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
            explicit_http_config:
              http2_protocol_options: {}
        load_assignment:
          cluster_name: gateway_control_plane
          endpoints:
          - lb_endpoints:
            - endpoint:
                address:
                  socket_address: {address: {{ ansible_operator_meta.name }}, port_value: 50051}
    admin:
      address:
        socket_address: {address: 0.0.0.0, port_value: 19000}
  envoy-path-rewrite.lua: |
    function envoy_on_response(handle)
      -- Full rewrite script from jewel; placeholder avoids LDS path errors
    end
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: '{{ ansible_operator_meta.name }}-envoy'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
    app.kubernetes.io/component: gateway-envoy
    app.kubernetes.io/managed-by: awx-operator
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
  template:
    metadata:
      labels:
        app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
        app.kubernetes.io/component: gateway-envoy
      annotations:
        awx.ansible.com/tls-mode: '{{ "secret" if (__use_tls_secret | default(false)) else "init-generated" }}'
{% if __use_tls_secret | default(false) %}
        checksum/tls-secret: '{{ __tls_secret }}'
{% endif %}
    spec:
      # Jewel LDS advertises cert paths under /etc/ansible-automation-platform/gateway/
      # (gateway.crt / gateway.key). Envoy must have real PEM material there.
{% if not (__use_tls_secret | default(false)) %}
      initContainers:
        - name: gen-tls
          image: '{{ init_tls_image | default("mirror.gcr.io/library/alpine:3.20") }}'
          command:
            - /bin/sh
            - -c
            - |
              set -e
              if command -v apk >/dev/null 2>&1; then apk add --no-cache openssl >/dev/null; fi
              mkdir -p /tls
              if [ ! -s /tls/gateway.crt ] || [ ! -s /tls/gateway.key ]; then
                openssl req -nodes -newkey rsa:2048 -keyout /tls/gateway.key -out /tmp/csr \
                  -subj "/CN={{ ansible_operator_meta.name }}-envoy" 2>/dev/null
                openssl x509 -req -days 3650 -in /tmp/csr -signkey /tls/gateway.key -out /tls/gateway.crt 2>/dev/null
                chmod 644 /tls/gateway.crt /tls/gateway.key
              fi
          volumeMounts:
            - name: tls
              mountPath: /tls
{% endif %}
      containers:
        - name: envoy
          image: '{{ envoy_image }}:{{ envoy_image_version }}'
          imagePullPolicy: '{{ image_pull_policy | default("IfNotPresent") }}'
          args: ["--config-path", "/etc/envoy/envoy.yaml"]
          env:
            - name: ENVOY_UID
              value: "0"
          ports:
            - name: https
              containerPort: 9080
            - name: admin
              containerPort: 19000
          readinessProbe:
            httpGet:
              path: /ready
              port: 19000
            initialDelaySeconds: 5
            periodSeconds: 10
          volumeMounts:
            - name: config
              mountPath: /etc/envoy/envoy.yaml
              subPath: envoy.yaml
            - name: config
              mountPath: /etc/envoy/envoy-path-rewrite.lua
              subPath: envoy-path-rewrite.lua
{% if __use_tls_secret | default(false) %}
            # Shared Secret with Jewel; map tls.crt/tls.key → gateway.crt/gateway.key
            - name: tls
              mountPath: /etc/ansible-automation-platform/gateway/gateway.crt
              subPath: tls.crt
            - name: tls
              mountPath: /etc/ansible-automation-platform/gateway/gateway.key
              subPath: tls.key
{% else %}
            - name: tls
              mountPath: /etc/ansible-automation-platform/gateway
{% endif %}
      volumes:
        - name: config
          configMap:
            name: '{{ ansible_operator_meta.name }}-envoy-config'
{% if __use_tls_secret | default(false) %}
        - name: tls
          secret:
            secretName: '{{ __tls_secret }}'
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
            defaultMode: 0644
{% else %}
        - name: tls
          emptyDir: {}
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: '{{ ansible_operator_meta.name }}-envoy'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
    app.kubernetes.io/managed-by: awx-operator
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-envoy'
  ports:
    - name: https
      port: 9080
      targetPort: 9080
    - name: admin
      port: 19000
      targetPort: 19000
