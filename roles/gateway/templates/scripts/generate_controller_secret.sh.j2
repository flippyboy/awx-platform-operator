#!/usr/bin/env bash
# Generate JWT service secret for api_slug=controller and store as K8s Secret.
set -euo pipefail
NS='{{ ansible_operator_meta.namespace }}'
NAME='{{ ansible_operator_meta.name }}'
{% raw %}
SECRET_NAME="${NAME}-controller-service-secret"

POD=$(kubectl -n "$NS" get pods -l "app.kubernetes.io/name=${NAME}" \
  -o jsonpath='{.items[0].metadata.name}')
if [ -z "$POD" ]; then
  echo "no jewel pod for $NAME" >&2
  exit 1
fi

# Jewel may print a colorama warning on stdout; extract between markers.
SECRET=$(kubectl -n "$NS" exec "$POD" -c jewel -- python3 -c '
import os, sys
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "aap_gateway_api.settings")
import django
django.setup()
from aap_gateway_api.models import ServiceAPIRoute
route = ServiceAPIRoute.objects.filter(api_slug="controller").first()
if route is None:
    sys.stderr.write("no ServiceAPIRoute api_slug=controller\n")
    sys.exit(2)
key = route.service_cluster.generate_key()
print("SECRET_BEGIN")
print(key.secret)
print("SECRET_END")
' 2>/tmp/jewel-gen-secret.err | awk '/^SECRET_BEGIN$/{p=1;next} /^SECRET_END$/{p=0} p' | tr -d '\r\n')

if [ -z "${SECRET}" ] || [ "${#SECRET}" -lt 20 ]; then
  echo "generate_service_secret failed:" >&2
  cat /tmp/jewel-gen-secret.err >&2 || true
  exit 1
fi
if printf '%s' "$SECRET" | grep -qiE 'failed|error|colorama'; then
  echo "secret looks polluted: $SECRET" >&2
  exit 1
fi

kubectl -n "$NS" create secret generic "$SECRET_NAME" \
  --from-literal=secret="$SECRET" \
  --dry-run=client -o yaml | kubectl apply -f -
echo "created ${SECRET_NAME} len=${#SECRET}"
{% endraw %}
