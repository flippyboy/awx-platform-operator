---
# Job: mint JWT service secret for api_slug=controller and write K8s Secret.
# Avoids kubectl and k8s_exec (OCI exec is flaky against jewel entrypoint).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: '{{ ansible_operator_meta.name }}-trust'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}'
    app.kubernetes.io/managed-by: awx-operator
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: '{{ ansible_operator_meta.name }}-trust'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/managed-by: awx-operator
rules:
  - apiGroups: [""]
    resources: [secrets]
    verbs: [get, create, update, patch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: '{{ ansible_operator_meta.name }}-trust'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/managed-by: awx-operator
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: '{{ ansible_operator_meta.name }}-trust'
subjects:
  - kind: ServiceAccount
    name: '{{ ansible_operator_meta.name }}-trust'
    namespace: '{{ ansible_operator_meta.namespace }}'
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: '{{ ansible_operator_meta.name }}-gen-secret-script'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/managed-by: awx-operator
data:
  gen_secret.py: |
    #!/usr/bin/env python3
    """Generate controller JWT secret and apply as K8s Secret via in-cluster API."""
    import base64, json, os, sys, urllib.error, urllib.request

    ns = os.environ["NAMESPACE"]
    secret_name = os.environ["SECRET_NAME"]
    sa_token_path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    ca_path = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    host = os.environ.get("KUBERNETES_SERVICE_HOST", "kubernetes.default.svc")
    port = os.environ.get("KUBERNETES_SERVICE_PORT", "443")

    # 1) Mint secret via Jewel Django ORM
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "aap_gateway_api.settings")
    import django
    django.setup()
    from aap_gateway_api.models import ServiceAPIRoute

    route = ServiceAPIRoute.objects.filter(api_slug="controller").first()
    if route is None:
        sys.stderr.write("no ServiceAPIRoute api_slug=controller — run register job first\n")
        sys.exit(2)
    key = route.service_cluster.generate_key()
    secret_val = key.secret
    if not secret_val or len(secret_val) < 20:
        sys.stderr.write("generated secret empty\n")
        sys.exit(3)
    sys.stderr.write(f"generated secret len={len(secret_val)}\n")

    # 2) Create/replace K8s Secret with SA token
    with open(sa_token_path) as f:
        token = f.read().strip()
    body = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": secret_name,
            "namespace": ns,
            "labels": {
                "app.kubernetes.io/managed-by": "awx-operator",
                "app.kubernetes.io/component": "gateway-trust",
            },
        },
        "type": "Opaque",
        "data": {
            "secret": base64.b64encode(secret_val.encode()).decode(),
        },
    }
    url = f"https://{host}:{port}/api/v1/namespaces/{ns}/secrets"
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )
    import ssl
    ctx = ssl.create_default_context(cafile=ca_path)
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=30) as r:
            sys.stderr.write(f"created secret {secret_name} status={r.status}\n")
    except urllib.error.HTTPError as e:
        if e.code == 409:
            # already exists — PATCH
            patch_url = f"{url}/{secret_name}"
            patch = {"data": body["data"]}
            preq = urllib.request.Request(
                patch_url,
                data=json.dumps(patch).encode(),
                method="PATCH",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Content-Type": "application/merge-patch+json",
                    "Accept": "application/json",
                },
            )
            with urllib.request.urlopen(preq, context=ctx, timeout=30) as r:
                sys.stderr.write(f"patched secret {secret_name} status={r.status}\n")
        else:
            sys.stderr.write(f"k8s API error {e.code}: {e.read().decode()}\n")
            raise
    print("ok")
---
apiVersion: batch/v1
kind: Job
metadata:
  name: '{{ ansible_operator_meta.name }}-gen-ctrl-secret'
  namespace: '{{ ansible_operator_meta.namespace }}'
  labels:
    app.kubernetes.io/name: '{{ ansible_operator_meta.name }}-gen-ctrl-secret'
    app.kubernetes.io/managed-by: awx-operator
spec:
  ttlSecondsAfterFinished: 600
  backoffLimit: 3
  template:
    spec:
      restartPolicy: OnFailure
      serviceAccountName: '{{ ansible_operator_meta.name }}-trust'
      containers:
        - name: gen
          # Same image as Jewel so Django models are available
          image: '{{ image }}:{{ image_version }}'
          imagePullPolicy: '{{ image_pull_policy | default("IfNotPresent") }}'
          env:
            - name: NAMESPACE
              value: '{{ ansible_operator_meta.namespace }}'
            - name: SECRET_NAME
              value: '{{ ansible_operator_meta.name }}-controller-service-secret'
            - name: DJANGO_SETTINGS_MODULE
              value: aap_gateway_api.settings
            - name: DATABASE_HOST
              value: '{{ __pg_host }}'
            - name: DATABASE_PORT
              value: '{{ __pg_port | string }}'
            - name: DATABASE_USER
              value: '{{ __pg_username }}'
            - name: DATABASE_PASSWORD
              value: '{{ __pg_password }}'
            - name: DATABASE_NAME
              value: '{{ database_name | default("gateway") }}'
            - name: REDIS_URL
              value: '{{ __redis_url | default("redis://" ~ ansible_operator_meta.name ~ "-redis:6379/0") }}'
            - name: REDIS_TLS
              value: "false"
          command: ["python3", "/scripts/gen_secret.py"]
          volumeMounts:
            - name: script
              mountPath: /scripts
            - name: secret-key
              mountPath: /etc/ansible-automation-platform/gateway/SECRET_KEY
              subPath: SECRET_KEY
            - name: settings
              mountPath: /etc/ansible-automation-platform/gateway/settings.py
              subPath: settings.py
      volumes:
        - name: script
          configMap:
            name: '{{ ansible_operator_meta.name }}-gen-secret-script'
            defaultMode: 0555
        - name: secret-key
          secret:
            secretName: '{{ __secret_key_secret }}'
            items:
              - key: SECRET_KEY
                path: SECRET_KEY
        - name: settings
          configMap:
            name: '{{ ansible_operator_meta.name }}-settings'
