# https://kubernetes.io/docs/concepts/overview/working-with-objects/common-labels/
app.kubernetes.io/part-of: '{{ ansible_operator_meta.name }}'
app.kubernetes.io/managed-by: '{{ deployment_type }}-operator'
app.kubernetes.io/component: '{{ deployment_type }}'
app.kubernetes.io/operator-version: '{{ lookup("env", "OPERATOR_VERSION") | default("", true) }}'
{% set _addl = lookup("template", "../common/templates/labels/additional_labels.yaml.j2") | default("", true) %}
{% if _addl is string and _addl | trim | length %}
{{ _addl | trim }}
{% endif %}
